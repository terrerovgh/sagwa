{
  "name": "sagwa-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "release-data": "node scripts/fetch-release-data.mjs",
    "dev": "node scripts/fetch-release-data.mjs && vite",
    "build": "node scripts/fetch-release-data.mjs && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
